// Packmates, a free map of meetups
// Small, self-contained SQLite database. Photos are stored as binary blobs
// directly in the DB (not on disk) so the app has no external file-storage
// dependency and works the same in dev and in production.
//
// Note: SQLite has no native enum type, so status/role fields below are
// plain strings constrained by convention (and by the app code, which only
// ever writes the values listed in the comment above each field).

generator client {
  provider = "prisma-client-js"
}

// As of Prisma 7, the client is always constructed with an explicit
// "adapter" (see src/lib/db.ts), there's no more implicit native-engine
// connection, so no "url" here. The CLI (migrate/generate) still needs one;
// that lives in prisma.config.ts instead.
datasource db {
  provider = "sqlite"
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  bio          String?
  city         String?
  pace         String? // free text, e.g. "5:30 / km"

  profilePhoto     Bytes?
  profilePhotoType String?

  /// "USER" | "ADMIN"
  role String @default("USER")

  /// "UNSUBMITTED" | "PENDING" | "APPROVED" | "REJECTED"
  verificationStatus String @default("UNSUBMITTED")

  /// "ACTIVE" | "SUSPENDED" | "BANNED"
  /// BANNED is for life: three red flags from people who met them at
  /// meetups (see src/lib/moderation.ts). SUSPENDED is an admin's call.
  accountStatus String @default("ACTIVE")

  // Set once the six-digit code we emailed them has been typed back in.
  // Null means unverified: they can log in, but nothing else, see
  // requireMember in src/lib/auth.ts. Nobody is held up by this when email
  // isn't configured, signups are stamped verified on the spot instead
  // (see emailVerificationEnabled in src/lib/email.ts).
  emailVerifiedAt DateTime?

  // Sequential membership number, #1 upwards, shown as a padded "#000042".
  // Purely an identity/badge, never a credential: it's printed on profiles
  // and guessable by design, which is why the invite code below is random
  // rather than derived from it.
  memberNumber Int? @unique

  // From the invite-only days, when every account needed a member's code
  // and invitedById recorded who vouched for them. Signup is open now and
  // nothing reads or spends these; they're kept so that history (who
  // brought in whom) isn't thrown away.
  inviteCode  String? @unique
  invitedById String?
  invitedBy   User?   @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    User[]  @relation("Invites")
  invitesLeft Int     @default(5)

  // Membership fee, paid in XRP. Switched OFF for now (the app is free
  // while it grows, see MEMBERSHIP_REQUIRED in src/lib/auth.ts); these
  // columns and the whole XRP flow stay in place, dormant, ready for when
  // charging starts. One shared wallet receives every payment;
  // xrpDestinationTag is how we tell members apart on the ledger (the
  // standard XRPL pattern exchanges use for shared deposit addresses).
  // paidUntil is a rolling expiry a payment pushes forward, not a
  // subscription object, there's no "cancel" on a push payment, it just
  // lapses. Admins bypass the check regardless of its value.
  xrpDestinationTag Int?      @unique
  paidUntil         DateTime?

  // The ✓ next to a name, and the key to the + button. Signup is open, so
  // posting meetups isn't: it unlocks once you've been to one meetup run
  // by somebody who already has this, which makes every host traceable to
  // a real meetup with real people at it (see src/lib/trust.ts). Members
  // from the invite-only days were stamped at the switch.
  memberVerifiedAt DateTime?

  // "Continue with Apple" / "Continue with Google": the provider's stable
  // id for this person, so a changed or hidden email address still finds
  // the same account. Null for email-and-password accounts.
  appleSub  String? @unique
  googleSub String? @unique

  // Wrong passwords in a row, and when that run locks the account until.
  // Five wrong and it waits fifteen minutes, which makes guessing a
  // password by trying thousands of them hopeless (see src/lib/lockout.ts).
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  // When the password last changed. Any session started before it is
  // refused (see getCurrentUser), so changing your password signs out
  // every other phone and browser, including whoever guessed the old one.
  passwordChangedAt DateTime?

  // The day-before reminder email, and the emails saying a meetup you're
  // going to has changed or been called off. On unless switched off on
  // the Me page.
  emailReminders Boolean @default(true)

  createdAt DateTime @default(now())

  verification      VerificationRequest?
  emailVerification EmailVerification?
  hostedActivities  RunActivity[]        @relation("HostedActivities")
  participations    Participation[]
  comments          Comment[]
  reportsMade       Report[]             @relation("ReportsMade")
  reportsReceived   Report[]             @relation("ReportsReceived")
  xrpPayments       XrpPayment[]
  thumbsGiven       ThumbsUp[]           @relation("ThumbsGiven")
  thumbsReceived    ThumbsUp[]           @relation("ThumbsReceived")
}

// One 👍 from one person to another, for one meetup they were both at.
// The unique key is what makes it one per person per meetup: a member's
// count is how many times somebody who actually met them was glad they
// came, not how many times one fan pressed a button.
model ThumbsUp {
  id         String      @id @default(cuid())
  activityId String
  activity   RunActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fromId     String
  from       User        @relation("ThumbsGiven", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         User        @relation("ThumbsReceived", fields: [toId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([activityId, fromId, toId])
  @@index([toId])
}

// One row per XRPL payment we've credited, keyed by transaction hash so the
// poller is safe to re-run over the same ledger history without double
// counting. Also doubles as an audit trail (see /admin).
model XrpPayment {
  id             String   @id @default(cuid())
  txHash         String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountXrp      Float
  amountGbp      Float // converted at the live rate when the poller saw it
  monthsCredited Int
  ledgerCloseAt  DateTime // when the payment actually settled on XRPL
  createdAt      DateTime @default(now()) // when our poller processed it
}

// The six-digit email code, one row per member, deleted the moment it's
// used. Short-lived by design: it expires, it only takes a handful of
// wrong guesses before it's spent, and sentAt throttles how often a new
// one can be requested.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

// Holds the sensitive verification photos separately from the User record.
// idPhoto is intentionally wiped once an admin makes a decision, we only
// need to have looked at it once, not keep it forever.
model VerificationRequest {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  selfiePhoto     Bytes
  selfiePhotoType String
  idPhoto         Bytes?
  idPhotoType     String?

  /// "PENDING" | "APPROVED" | "REJECTED"
  status String @default("PENDING")

  reviewerNote String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
}

model RunActivity {
  id              String   @id @default(cuid())
  hostId          String
  host            User     @relation("HostedActivities", fields: [hostId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  location        String
  // Best-effort geocode of `location`, filled in at creation time so the
  // map view has something to plot. Null when geocoding failed or hasn't
  // run yet, the map view just skips those activities.
  latitude        Float?
  longitude       Float?
  startsAt        DateTime
  distanceKm      Float?
  pace            String?
  maxParticipants Int?
  stravaUrl       String?

  // What kind of meetup this is: running is the heart of it and stays the
  // default, but the same machinery carries walks, rides, gym sessions and
  // the entirely non-sport ones (coffee, food, pub). See CATEGORIES in
  // src/lib/categories.ts, which is the single source of truth for the
  // labels and map-pin emoji.
  category String @default("RUN")

  // How to spot the group when you get there: "yellow jacket, by the
  // gate". The commonest way a first meetup goes wrong is turning up at
  // the right place and not knowing who you're looking for.
  findUs String?

  // Free text for wherever people are heading afterwards, e.g. "The Crown,
  // 12 High Street". One field rather than a name/address pair, it's read
  // by humans, not parsed.
  afterSpot String?

  // Set when the host (or an admin) calls it off. Kept rather than deleted
  // so the people going see "cancelled" on their profile instead of the
  // meetup silently vanishing; it comes off the map straight away.
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  participations Participation[]
  comments       Comment[]
  thumbsUps      ThumbsUp[]
}

model Participation {
  id         String      @id @default(cuid())
  activityId String
  activity   RunActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "JOINED" | "WAITLIST" | "CANCELLED"
  status String @default("JOINED")

  joinedAt DateTime @default(now())

  // When the day-before reminder went to this person for this meetup, so
  // the daily job never sends it twice however often it runs.
  reminderSentAt DateTime?

  @@unique([activityId, userId])
}

model Comment {
  id         String      @id @default(cuid())
  activityId String
  activity   RunActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime    @default(now())
}

model Report {
  id             String  @id @default(cuid())
  reporterId     String
  reporter       User    @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User    @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  activityId     String?
  reason         String

  /// "OPEN" | "RESOLVED"
  status String @default("OPEN")

  createdAt DateTime @default(now())
}
