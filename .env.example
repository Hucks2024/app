# Copy this file to .env and fill in real values before running the app.

# SQLite database file (local dev). See README for production notes —
# Vercel's serverless filesystem is ephemeral, so a plain file won't
# persist there; use Turso/libSQL or a host with a persistent disk instead.
DATABASE_URL="file:./dev.db"

# Random long string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL of the deployed site (used for canonical links / Open Graph tags).
NEXT_PUBLIC_SITE_URL="https://doyoulikepizza.com"

# Seeded automatically on first `npm run db:seed`. Change the password
# immediately after your first login in production.
ADMIN_EMAIL="admin@doyoulikepizza.com"
ADMIN_PASSWORD="changeme123"

# Optional — set BOTH to use a hosted Turso (libSQL) database instead of the
# local SQLite file above. When set, this takes priority over DATABASE_URL.
# See README for how to create one and why you'd want to (serverless hosts
# with no persistent disk, e.g. Vercel).
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
