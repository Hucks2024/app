# Copy this file to .env and fill in real values before running the app.

# --- Required in production (e.g. Vercel) ---
# The app talks to Turso/libSQL, not a local file, whenever these are set;
# see src/lib/db.ts. Uncommented here (with placeholders) specifically so
# that Vercel's "detect variables from .env.example" step on project import
# picks these up; leave DATABASE_URL/ADMIN_* below alone, they're local-dev
# only and Vercel doesn't need them.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Random long string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Public URL of the deployed site (used for canonical links / Open Graph tags).
NEXT_PUBLIC_SITE_URL="https://doyoulikepizza.com"

# The wallet the £1/month membership gets paid into (see src/app/subscribe,
# scripts/process-xrp-payments.mjs). Not sensitive, an address is meant to
# be public, that's how receiving crypto payments works, so the real one
# is committed here rather than left as a placeholder.
XRP_WALLET_ADDRESS="rfVyq5iAAdxk8jMQcSoGCVvBaXoEJiH9iV"

# --- Local development only, NOT read by the deployed app ---

# SQLite database file, used only when TURSO_DATABASE_URL above is unset.
# Vercel's serverless filesystem is ephemeral, so a plain file won't persist
# there, this is purely a local-dev convenience.
DATABASE_URL="file:./dev.db"

# Seeded automatically on first `npm run db:seed` (local dev only, the
# production database is set up via the one-time GitHub Actions workflow
# instead, see scripts/turso-setup.sql).
ADMIN_EMAIL="admin@doyoulikepizza.com"
ADMIN_PASSWORD="changeme123"
