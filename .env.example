# Copy this file to .env and fill in real values before running the app.

# --- Required in production (e.g. Vercel) ---
# The app talks to Turso/libSQL, not a local file, whenever these are set;
# see src/lib/db.ts. Uncommented here (with placeholders) specifically so
# that Vercel's "detect variables from .env.example" step on project import
# picks these up; leave DATABASE_URL/ADMIN_* below alone, they're local-dev
# only and Vercel doesn't need them.
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Random long string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string"

# Only for running locally: the live address is packmates.live, set in
# src/lib/site.ts. Anything that isn't an http:// address is ignored.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email verification at signup. Leave both unset and it's simply switched
# off: new accounts are created already-verified and nobody is asked for a
# code, so the app works with no email provider at all. Set RESEND_API_KEY
# (resend.com, free for 3,000 a month) and new signups have to type a
# six-digit code from their inbox before they can do anything.
# EMAIL_FROM must be on a domain verified with Resend; their
# onboarding@resend.dev works for testing but only delivers to the address
# that owns the Resend account.
# RESEND_API_KEY="re_..."
# EMAIL_FROM is optional: emails come from hello@packmates.live by default.

# "Continue with Apple" / "Continue with Google" on the sign in screen.
# Each button only appears once its keys are set; email sign in works
# either way. Register these as the return URLs on the provider's side:
#   https://packmates.live/auth/apple/callback
#   https://packmates.live/auth/google/callback
# APPLE_CLIENT_ID is the Services ID from developer.apple.com (Certificates,
# Identifiers & Profiles -> Identifiers -> Services IDs), with Sign in with
# Apple switched on for it. No key file is needed. The Google pair comes
# from console.cloud.google.com -> APIs & Services -> Credentials -> OAuth
# client ID (Web application).
# APPLE_CLIENT_ID="live.packmates.web"
# GOOGLE_CLIENT_ID="1234-abcd.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Switches the membership fee back on. Unset (or anything other than
# "true") means the app is free for everyone, and the whole XRP flow below
# sits dormant. Flip this to "true" when it's
# time to start charging, nothing else needs to change.
# MEMBERSHIP_REQUIRED="true"

# The wallet the membership fee gets paid into (see src/app/subscribe and
# src/lib/xrp.ts, credited when an admin presses "Scan now" on /admin). Not
# sensitive, an address is meant to be public, that's how receiving crypto
# payments works, so the real one is committed here rather than left as a
# placeholder.
XRP_WALLET_ADDRESS="rfVyq5iAAdxk8jMQcSoGCVvBaXoEJiH9iV"

# --- Local development only, NOT read by the deployed app ---

# SQLite database file, used only when TURSO_DATABASE_URL above is unset.
# Vercel's serverless filesystem is ephemeral, so a plain file won't persist
# there, this is purely a local-dev convenience.
DATABASE_URL="file:./dev.db"

# Seeded automatically on first `npm run db:seed` (local dev only, the
# production database is set up via the one-time GitHub Actions workflow
# instead, see scripts/turso-setup.sql).
ADMIN_EMAIL="admin@doyoulikepizza.com"
ADMIN_PASSWORD="changeme123"
