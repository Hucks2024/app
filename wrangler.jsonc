// Packmates on Cloudflare Workers, built by OpenNext (npm run cf:build) and
// sent up by .github/workflows/cloudflare.yml. Settings and secrets (the
// database, the session key, Resend) live in Cloudflare, never here: this
// repository is public.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "packmates",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The live addresses. packmates.live itself just redirects to www
  // (src/proxy.ts).
  "routes": [
    { "pattern": "www.packmates.live", "custom_domain": true },
    { "pattern": "packmates.live", "custom_domain": true }
  ],
  // No test address (*.workers.dev): it has the account's name in it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Makes iPhone photos (JPEGs) into small WebPs: src/lib/images.ts.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
